#. Translators: Switch to the next voice gesture description for the Input gestures settings dialog
#: addon\globalPlugins\voiceToggle\__init__.py:35
msgid "Switches to the next voice."
msgstr "Prepne na nasledujúci hlas"

#. Translators: Switch to the previous voice gesture description for the Input gestures settings dialog
#: addon\globalPlugins\voiceToggle\__init__.py:43
msgid "Switches to the previous voice."
msgstr "Prepne na predchádzajúci hlas"

#. Translators: Select a voice gesture description for the Input gestures settings dialog
#: addon\globalPlugins\voiceToggle\__init__.py:51
msgid "Shows the dialog for selecting a voice."
msgstr "Zobrazí dialóg pre výber hlasu"

#. Translators: Label for the silence synthesizer in the voices listbox or synthesizers and voices comboboxes
msgid "Silence"
msgstr "Bez reči"

#: addon\globalPlugins\voiceToggle\selectVoiceDialog.py:25
msgid "Select a voice"
msgstr "Vyberte hlas"

#. Translators: Label for the voices listbox in the Select a voice dialog
#. Translators: Label for the voices listbox in the add-on settings
#: addon\globalPlugins\voiceToggle\selectVoiceDialog.py:36
#: addon\globalPlugins\voiceToggle\settingsDialogs.py:49
msgid "Voices"
msgstr "Hlasy"

#. Translators: Label for the OK button in the select a voice dialog
#: addon\globalPlugins\voiceToggle\selectVoiceDialog.py:43
msgid "OK"
msgstr "OK"

#. Translators: Label for the cancel button in the select voice dialog
#. Translators: Label for the cancel button in the add voice dialog
#: addon\globalPlugins\voiceToggle\selectVoiceDialog.py:48
#: addon\globalPlugins\voiceToggle\settingsDialogs.py:158
msgid "Cancel"
msgstr "Zrušiť"

#. Translators: Add-on settings panel title
#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on
#. to be shown on installation and add-on information found in Add-ons Manager.
msgid "VoiceToggle"
msgstr ""

#. Translators: Label for the add voice button in the add-on settings
msgid "Add voice"
msgstr "Pridať hlas"

#. Translators: Label for the remove voice button in the add-on settings
msgid "Remove voice"
msgstr "Odstrániť hlas"

#. Translators: Label for the update voice when NVDA's own speech settings change checkbox in the add-on settings
#: addon\globalPlugins\voiceToggle\settingsDialogs.py:67
msgid "Update voice when NVDA's own speech settings change"
msgstr "Aktualizovať hlas pri jeho zmene cez nastavenie reči samotného NVDA"

msgid "The last remaining voice cannot be removed"
msgstr "Posledný zostávajúci hlas nie je možné odstrániť"

#. Translators: Label for the synthesizers combobox in the add voice dialog
msgid "Synthesizer"
msgstr "Hlasový výstup"

#. Translators: Label for the voices combobox in the add voice dialog
msgid "Voice"
msgstr "Hlas"

#. Translators: Label for the add button in the add voice dialog
msgid "Add"
msgstr "Pridať"

#. Translators: Value of the voices combobox in the add voice dialog when no voices are available
#: addon\globalPlugins\voiceToggle\settingsDialogs.py:185
msgid "No voices available"
msgstr "Žiadne hlasy nie sú dostupné"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-ons manager
msgid ""
"Allows easy toggling between predefined voices.\n"
"Define voices in NVDA settings, then use NVDA + Alt + V anytime to toggle to "
"the next voice."
msgstr "Umožňuje ľahké prepínanie medzi predvolenými hlasmi.\nDefinujte požadované hlasy v nastavení NVDA, a potom kedykoľvek použite skratku NVDA + Alt + L pre prepnutie na nasledujúci hlas alebo NVDA + Alt + V pre výber hlasu zo zoznamu."
